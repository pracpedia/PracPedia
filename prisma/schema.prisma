// Prisma schema for PracPedia (Practical Notebook Gallery)
//
// PostgreSQL-only. The project no longer supports SQLite — Neon serverless
// Postgres is the recommended production provider. Set DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("user") // "user" | "admin" | "super_admin" | "artist"
  studyTime     Int      @default(0)
  profilePic    String?
  phoneNumber   String?
  bio           String?
  isAdminStudent Boolean @default(false)
  isPremium     Boolean  @default(false)
  aiCredits     Int      @default(0)

  // Granular permissions for admins
  permissionsJson String   @default("[]")

  // Artist marketplace fields
  rateDrawingOnly  Int      @default(150)
  rateDrawingWriting Int    @default(300)
  notebookCost     Int      @default(100)
  specialtiesJson String   @default("[]")
  isAvailable     Boolean  @default(true)
  rating          Float    @default(5.0)
  completedOrders Int      @default(0)

  // IP address tracking
  lastIpAddress String?

  // Trial-credit recharge cooldown
  lastRechargeAt DateTime?


  // Presence tracking
  lastSeenAt DateTime?

  // ── NEW: Notification system — when the user last saw their notifications ──
  // Used by /api/notifications to determine which messages are "unread"
  lastNotificationSeen DateTime?

  // ── Assistant system (Additive Model) ──────────────────────────────────────
  // If set, this user is an assistant to the artist with this ID.
  // Users can be BOTH independent artists (rates > 0) AND assistants (parentArtistId set).
  parentArtistId String?
  parentArtist   User?   @relation("AssistantParent", fields: [parentArtistId], references: [id], onDelete: SetNull)
  assistants     User[]  @relation("AssistantParent")

  // Total earnings from completed assistant subtasks (in BDT).
  assistantEarnings Int @default(0)
  assistantCompletedOrders Int @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookingsAsClient  Booking[]    @relation("BookingClient")
  bookingsAsArtist  Booking[]    @relation("BookingArtist")
  portfolio         PortfolioItem[]

  // Assistant system relations
  subtasksAssigned  SubTask[]     @relation("SubTaskAssistant")
  subtasksCreated   SubTask[]     @relation("SubTaskParentArtist")
  invitesSent       AssistantInvite[] @relation("InviteParentArtist")

    // Order chat messages sent by this user
  orderChatsSent OrderChat[] @relation("OrderChatSender")

  @@index([role])
  @@index([isAvailable, rating])
  @@index([lastSeenAt])
  @@index([parentArtistId])
  @@map("users")
}

model Subject {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folders     Folder[]
  chatMessages ChatMessage[]

  @@map("subjects")
}

model Folder {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String
  imagesJson  String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@map("folders")
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  content      String
  deadline     String?
  fileUrl      String?
  fileName     String?
  fileSize     Int      @default(0)
  targetUserId String?  // null = broadcast; user ID = targeted; also used as KV key for landing/banner-config
  createdById  String
  createdByName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([targetUserId])
  @@index([createdById])
  @@map("announcements")
}

model ChatMessage {
  id         String   @id @default(cuid())
  subjectId  String?
  userId     String
  userName   String
  userRole   String   @default("user")
  userAvatar String?
  text       String
  imageUrl   String?
  createdAt  DateTime @default(now())

  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model HireRequest {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String
  subject    String
  message    String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@map("hire_requests")
}

model Booking {
  id            String   @id @default(cuid())
  clientId      String
  artistId      String
  serviceType   String   @default("drawing_only")
  notebookProvider String @default("client")
  subject       String
  description   String
  referenceImagesJson String @default("[]")
  price             Int      @default(0)
  commissionPercent Int      @default(0)
  commissionAmount  Int      @default(0)
  artistEarnings    Int      @default(0)
  status        String   @default("pending")
  paymentStatus String   @default("unpaid")
    clientNotes   String?
  artistNotes   String?
  // ── NEW: Deadline when the client needs delivery (optional) ──
  deadline      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        User     @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  artist        User     @relation("BookingArtist", fields: [artistId], references: [id], onDelete: Cascade)
  subtasks      SubTask[]
    // Chat messages for this order
  orderChats OrderChat[]

    @@index([clientId, status])
  @@index([artistId, status])
  @@index([status])
  @@index([deadline])
  @@map("bookings")
}

model PortfolioItem {
  id          String   @id @default(cuid())
  artistId    String
  imageUrl    String
  title       String
  description String   @default("")
  tagsJson    String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artist      User     @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@map("portfolio_items")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("Anonymous")
  userRole  String   @default("user")
  action    String
  category  String   @default("user")
  detail    String   @default("")
  metadataJson String @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([category])
  @@index([action])
  @@map("activity_logs")
}

// ── Assistant System ─────────────────────────────────────────────────────

model AssistantInvite {
  id              String   @id @default(cuid())
  code            String   @unique
  parentArtistId  String
  parentArtist    User     @relation("InviteParentArtist", fields: [parentArtistId], references: [id], onDelete: Cascade)
  inviteeEmail    String   @default("") // Optional, used for pre-fill + email
  inviteeName     String?
  defaultRole     String   @default("both")
  defaultSplitPercent Int  @default(40)
  status          String   @default("pending")
  expiresAt       DateTime
  acceptedById    String?
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())
  @@index([parentArtistId])
  @@index([status])
  @@map("assistant_invites")
}

model SubTask {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assistantId     String
  assistant       User     @relation("SubTaskAssistant", fields: [assistantId], references: [id], onDelete: Cascade)
  parentArtistId  String
  parentArtist    User     @relation("SubTaskParentArtist", fields: [parentArtistId], references: [id], onDelete: Cascade)
  taskType        String   // "drawing" | "writing"
  splitPercent    Int
  earnings        Int
  status          String   @default("assigned") // assigned | in_progress | completed | declined
  assignedAt      DateTime @default(now())
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([bookingId, taskType])
  @@index([assistantId, status])
  @@index([parentArtistId])
  @@index([bookingId])
  @@map("subtasks")
}


// ── Order Chat System ─────────────────────────────────────────────────────

model OrderChat {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("OrderChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@map("order_chats")
}

