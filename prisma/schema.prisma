// Prisma schema for PracPedia (Practical Notebook Gallery)
//
// PostgreSQL-only. The project no longer supports SQLite — Neon serverless
// Postgres is the recommended production provider. Set DATABASE_URL in .env
// (see .env.example for the format — do NOT include channel_binding=require).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("user") // "user" | "admin" | "super_admin" | "artist"
  studyTime     Int      @default(0)
  profilePic    String?
  phoneNumber   String?
  bio           String?
  isAdminStudent Boolean @default(false)
  isPremium     Boolean  @default(false)
  aiCredits     Int      @default(0)

  // Granular permissions for admins — JSON array of permission keys.
  // Super admins have all permissions implicitly. Regular admins only have
  // the permissions assigned to them by a super admin.
  permissionsJson String   @default("[]")

  // Artist marketplace fields
  rateDrawingOnly  Int      @default(150)
  rateDrawingWriting Int    @default(300)
  notebookCost     Int      @default(100)
  specialtiesJson String   @default("[]")
  isAvailable     Boolean  @default(true)
  rating          Float    @default(5.0)
  completedOrders Int      @default(0)

  // IP address tracking
  lastIpAddress String?

    // Trial-credit recharge cooldown — set to the current time when the user
  // self-recharges via /api/users/recharge-trial. Regular users are limited
  // to one recharge per 24h. Platform owners bypass.
  lastRechargeAt DateTime?

  // Presence tracking — updated every 30s by /api/presence/heartbeat.
  // Used by ClassroomDiscussion to show "Active Scholars Online" indicator.
  lastSeenAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookingsAsClient  Booking[]    @relation("BookingClient")
  bookingsAsArtist  Booking[]    @relation("BookingArtist")
  portfolio         PortfolioItem[]

  @@index([role])
  @@index([isAvailable, rating])
  @@index([lastSeenAt])
  @@map("users")
}

model Subject {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folders     Folder[]
  chatMessages ChatMessage[]

  @@map("subjects")
}

model Folder {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String
  imagesJson  String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@map("folders")
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  content      String
  deadline     String?
  fileUrl      String?
  fileName     String?
  fileSize     Int      @default(0)
  targetUserId String?  // null = broadcast; user ID = targeted; also used as KV key for landing/banner-config
  createdById  String
  createdByName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([targetUserId])
  @@index([createdById])
  @@map("announcements")
}

model ChatMessage {
  id         String   @id @default(cuid())
  subjectId  String?
  userId     String
  userName   String
  userRole   String   @default("user")
  userAvatar String?
  text       String
  imageUrl   String?
  createdAt  DateTime @default(now())

  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model HireRequest {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String
  subject    String
  message    String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@map("hire_requests")
}

model Booking {
  id            String   @id @default(cuid())
  clientId      String
  artistId      String
  serviceType   String   @default("drawing_only")
  notebookProvider String @default("client")
  subject       String
  description   String
  referenceImagesJson String @default("[]")
  price             Int      @default(0)
  commissionPercent Int      @default(0)
  commissionAmount  Int      @default(0)
  artistEarnings    Int      @default(0)
  status        String   @default("pending")
  paymentStatus String   @default("unpaid")
  clientNotes   String?
  artistNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        User     @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  artist        User     @relation("BookingArtist", fields: [artistId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([artistId, status])
  @@index([status])
  @@map("bookings")
}

model PortfolioItem {
  id          String   @id @default(cuid())
  artistId    String
  imageUrl    String
  title       String
  description String   @default("")
  tagsJson    String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artist      User     @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@map("portfolio_items")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("Anonymous")
  userRole  String   @default("user")
  action    String
  category  String   @default("user")
  detail    String   @default("")
  metadataJson String @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([category])
  @@index([action])
  @@map("activity_logs")
}
