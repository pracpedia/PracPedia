# Allow install scripts for trusted packages (silences npm warn allow-scripts)
# These are all well-known, safe packages that need postinstall scripts:
# - @prisma/client: generates the Prisma Client TypeScript types
# - prisma: downloads the Prisma query engine binary
# - @prisma/engines: Prisma's database engine binaries
# - esbuild: downloads the platform-specific esbuild binary
# - unrs-resolver: builds native resolver bindings
ignore-scripts=false
fund=false
audit-level=high

# Explicitly allow these specific packages to run install scripts
# (this is what silences the warning on Vercel's npm ci)
allow-scripts=@prisma/client
allow-scripts=@prisma/engines
allow-scripts=prisma
allow-scripts=esbuild
allow-scripts=unrs-resolver