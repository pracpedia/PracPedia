# Docker build context exclusions — keeps the image small and build fast.

# Version control
.git
.gitignore

# Dependencies (will be installed in the deps stage)
node_modules

# Build artifacts
.next
out
build
dist

# Runtime data
db
data
*.db
*.db-journal

# Logs
*.log
dev.log
server.log

# Editor / IDE
.vscode
.idea
*.swp
*.swo
.DS_Store

# Environment files (build-time secrets via BuildKit, not COPY)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Documentation (not needed at runtime)
README.md
CUSTOMIZATION.md
LICENSE

# CI / testing
.github
.gitlab-ci.yml
