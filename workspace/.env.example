# PracPedia Environment Variables
# Copy this file to `.env` and edit the values for your setup.

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
# SQLite (default — dev only). Path is relative to project root.
DATABASE_URL="file:./db/custom.db"

# PostgreSQL (recommended for production). Uncomment and set your connection string.
# Examples:
#   Neon:        postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?schema=public
#   Supabase:    postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#   Self-hosted: postgresql://user:pass@localhost:5432/pracpedia
# DATABASE_URL="postgresql://user:pass@host:5432/pracpedia?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs (HMAC-SHA256). Generate a strong random string:
#   openssl rand -hex 32
# IMPORTANT: Change this in production. The default is for local dev only.
JWT_SECRET="pracpedia_default_secret_change_me_2026"

# ─────────────────────────────────────────────────────────────────────────────
# TEST MODE (DEV ONLY — disable in production!)
# ─────────────────────────────────────────────────────────────────────────────
# When "true", the /api/credentials endpoint returns demo-account emails with
# plaintext passwords (super_admin only). Used for QA/testing.
# Set to "false" or leave unset for production.
PRACPEDIA_TEST_PASSWORDS_VISIBLE="false"

# ─────────────────────────────────────────────────────────────────────────────
# AI (BYOK — Bring Your Own Key)
# ─────────────────────────────────────────────────────────────────────────────
# Optional server-side fallback for /api/academy/* routes when the user has
# not supplied their own Gemini API key via the sidebar key modal.
# Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# PLATFORM OWNER PROTECTION
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that bypass client-side checks
# (e.g. Gmail blocking). Useful for testing with disposable email providers.
# PLATFORM_OWNER_EMAILS="admin@gallery.com,admin2@gallery.com"

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME
# ─────────────────────────────────────────────────────────────────────────────
# Set to "production" for optimized builds. Next.js sets this automatically
# when you run `next build` or `next start`.
# NODE_ENV="development"

# ─────────────────────────────────────────────────────────────────────────────
# VERCEL BLOB (image storage — required for production on Vercel)
# ─────────────────────────────────────────────────────────────────────────────
# When set, images are uploaded to Vercel Blob Storage instead of being stored
# as base64 data URLs in the database. This keeps the DB small and fast.
#
# Get a token at: Vercel Dashboard → Storage → Create Blob Store → Copy token
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────────────────────
# SENTRY (error monitoring — optional but recommended for production)
# ─────────────────────────────────────────────────────────────────────────────
# Get a DSN at: https://sentry.io → Create Project → Next.js
# SENTRY_DSN="https://xxxxxxxx@oXXXXX.ingest.sentry.io/XXXXX"
# SENTRY_AUTH_TOKEN="sntrys_eyJpYXQiO..."
# Next.js build-time Sentry org/project (for source map uploads)
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="pracpedia"
