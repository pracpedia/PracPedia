# ──────────────────────────────────────────────────────────────────────────
# PracPedia — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and replace every placeholder with your own values.
# NEVER commit your real .env to git (it's already in .gitignore).
#
# ⚠️  Rotate the Neon DB password (and any other production secrets) BEFORE
#     deploying — never reuse the placeholder values in production.
#
# See DEPLOYMENT.md for a full step-by-step setup guide.

# ── DATABASE_URL ───────────────────────────────────────────────────────────
# PostgreSQL connection string. The Prisma schema uses the `postgresql`
# provider exclusively — SQLite is no longer supported.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
#
# NOTE: Do NOT append `channel_binding=require` — Prisma's URL parser
# doesn't accept it. Use `sslmode=require` only.
#
# Recommended: use a serverless Postgres provider like Neon (https://neon.tech)
# or Supabase (https://supabase.com). Both have free tiers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# ── JWT_SECRET ─────────────────────────────────────────────────────────────
# Secret used to sign auth tokens. Generate with:
#   openssl rand -hex 32
# In a future hardening pass this will be used to sign JWTs; for now it's
# declared for production readiness.
JWT_SECRET=REPLACE_WITH_32_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32

# ── PLATFORM_OWNER_EMAILS ──────────────────────────────────────────────────
# Comma-separated list of emails that are always treated as platform owners
# (super admins with all permissions, bypass all permission checks, and
# cannot be demoted). Add your own email here.
PLATFORM_OWNER_EMAILS=you@example.com

# ── AI_CREDITS_DEFAULT ─────────────────────────────────────────────────────
# How many AI credits each new user starts with. One credit = one AI vision
# call (notebook page analysis). Recharging is rate-limited to once per 24h
# per user (see /api/users/recharge-trial).
AI_CREDITS_DEFAULT=25

# ── PRACPEDIA_TEST_PASSWORDS_VISIBLE ───────────────────────────────────────
# When `true` AND not in production (NODE_ENV !== 'production'), the
# /api/credentials endpoint returns all users' plaintext passwords to super
# admins (for local development only). The isProduction() hard-block in
# src/lib/test-mode.ts ensures this is always OFF in production even if the
# flag is accidentally set.
PRACPEDIA_TEST_PASSWORDS_VISIBLE=true

# ── GEMINI_API_KEY (optional — server fallback) ────────────────────────────
# Optional server-side Gemini API key used as a fallback if a user hasn't
# connected their own (BYOK). Most deployments leave this blank — the BYOK
# flow is the primary path and there's no shared quota.
GEMINI_API_KEY=

# ── BLOB_READ_WRITE_TOKEN (optional — Vercel Blob) ──────────────────────────
# Vercel Blob access token for storing uploaded images and announcement
# file attachments. When unset, the app falls back to base64 data URLs
# stored inline in the DB (dev-only — bloats the DB in prod).
#
# Get a token at: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=
