# ── Database ────────────────────────────────────────────────────────────────
# Prisma reads this for "postgresql" provider. Currently unused (schema is
# configured for SQLite pointing at /home/z/my-project/db/custom.db), but kept
# here so the postgres schema variant still works if you switch with
# `bun run db:use-postgres`.
DATABASE_URL=postgresql://neondb_owner:npg_8IOH2VZBAJrz@ep-spring-moon-ax91e98c-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Used by /lib/auth.ts (signToken/verifyToken). In test mode tokens are just
# base64 payloads — this secret is reserved for a future HMAC upgrade.
JWT_SECRET=pracpedia_default_dev_secret_DO_NOT_USE_IN_PROD_2026

# ── Platform owners ──────────────────────────────────────────────────────────
# Comma-separated list of emails that bypass Gmail blocking AND cannot be
# demoted/deleted by other admins (including other super_admins).
# Always includes the seed owner "pracpedia@gmail.com".
PLATFORM_OWNER_EMAILS=mahabubrahmanakash275@gmail.com

# ── AI credits (Academy) ─────────────────────────────────────────────────────
# New users start with this many AI credits. Recharge-trial endpoint tops up
# users back to this number.
AI_CREDITS_DEFAULT=25

# ── Test mode flags ──────────────────────────────────────────────────────────
# When true, the credentials viewer shows plaintext passwords to super_admins.
PRACPEDIA_TEST_PASSWORDS_VISIBLE=true

# ── Optional integrations (leave blank for dev) ──────────────────────────────
# Used by z-ai-web-dev-sdk for AI Academy chat/lesson endpoints.
GEMINI_API_KEY=
# Used by /lib/blob-storage.ts for production image uploads. When absent, the
# app falls back to base64 data URLs stored inline in the DB.
BLOB_READ_WRITE_TOKEN=
