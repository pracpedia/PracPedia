// Prisma schema for PracPedia (Practical Notebook Gallery)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("user") // "user" | "admin" | "super_admin" | "artist"
  studyTime     Int      @default(0)
  profilePic    String?
  phoneNumber   String?
  bio           String?
  isAdminStudent Boolean @default(false)
  isPremium     Boolean  @default(false)
  aiCredits     Int      @default(0)
  scareTriggered Boolean @default(false)
  catTriggered  Boolean  @default(false)

  // Artist marketplace fields
  rateDrawingOnly  Int      @default(150)   // BDT price for "Drawing Only" service
  rateDrawingWriting Int    @default(300)   // BDT price for "Drawing + Writing" service
  specialtiesJson String   @default("[]")   // JSON array of strings
  isAvailable     Boolean  @default(true)   // accepting new commissions?
  rating          Float    @default(5.0)    // average rating (0-5)
  completedOrders Int      @default(0)      // total completed commissions

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookingsAsClient  Booking[]    @relation("BookingClient")
  bookingsAsArtist  Booking[]    @relation("BookingArtist")
  portfolio         PortfolioItem[]

  // Index the role column — every admin dashboard query filters by role
  @@index([role])
  // Compound index for marketplace listing: availability + rating for sorting
  @@index([isAvailable, rating])
  @@map("users")
}

model Subject {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folders     Folder[]
  chatMessages ChatMessage[]

  @@map("subjects")
}

model Folder {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String
  imagesJson  String   @default("[]") // JSON array of {url, title}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Folder listing is always filtered by subjectId
  @@index([subjectId])
  @@map("folders")
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  content      String
  deadline     String?
  createdById  String
  createdByName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("announcements")
}

model ChatMessage {
  id         String   @id @default(cuid())
  subjectId  String?
  userId     String
  userName   String
  userRole   String   @default("user")
  userAvatar String?
  text       String
  createdAt  DateTime @default(now())

  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Chat messages are always fetched by subjectId, newest first
  @@index([subjectId, createdAt])
  // Also index userId for "messages by this user" queries
  @@index([userId])
  @@map("chat_messages")
}

model HireRequest {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String
  subject    String
  message    String
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Admin inbox is filtered by status
  @@index([status])
  @@map("hire_requests")
}

model Booking {
  id            String   @id @default(cuid())
  clientId      String
  artistId      String
  serviceType   String   @default("drawing_only") // "drawing_only" | "drawing_writing"
  subject       String
  description   String
  referenceImagesJson String @default("[]") // JSON array of {url, title}
  price         Int      @default(0)        // BDT
  status        String   @default("pending") // pending | in_progress | completed | cancelled
  paymentStatus String   @default("unpaid")  // unpaid | paid | refunded
  clientNotes   String?
  artistNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        User     @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  artist        User     @relation("BookingArtist", fields: [artistId], references: [id], onDelete: Cascade)

  // Bookings are always queried by client OR artist, filtered by status
  @@index([clientId, status])
  @@index([artistId, status])
  @@index([status])
  @@map("bookings")
}

model PortfolioItem {
  id          String   @id @default(cuid())
  artistId    String
  imageUrl    String
  title       String
  description String   @default("")
  tagsJson    String   @default("[]") // JSON array of subject tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artist      User     @relation(fields: [artistId], references: [id], onDelete: Cascade)

  // Portfolio is always fetched by artistId
  @@index([artistId])
  @@map("portfolio_items")
}

/// Activity log entry — tracks user actions for the admin real-time feed.
/// Each row is one event: login, register, booking created, message posted, etc.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?  // null for anonymous/public events
  userName  String   @default("Anonymous")
  userRole  String   @default("user")
  action    String   // e.g. "login", "register", "booking_created", "message_sent"
  category  String   @default("user") // "auth" | "user" | "content" | "marketplace" | "chat" | "system"
  detail    String   @default("")    // human-readable description
  metadataJson String @default("{}") // JSON object with extra context (e.g. bookingId, subjectId)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])     // newest first — main query pattern
  @@index([userId])         // filter by user
  @@index([category])       // filter by category
  @@index([action])         // filter by action type
  @@map("activity_logs")
}
